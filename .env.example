# Local development starts the built-in PostgreSQL.
# Production (Vercel) sets EMBEDDED_PG=0 and a hosted PostgreSQL DATABASE_URL.
EMBEDDED_PG=1
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/aceit?schema=public
AUTH_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=admin@aceit.dev
ADMIN_PASSWORD=replace-with-a-password
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
